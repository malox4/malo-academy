# Copy to .env and set your own values before any public host.
# docker compose up --build  reads this file. It is not copied into the image.

POSTGRES_USER=hall
POSTGRES_PASSWORD=replace-before-deploy
POSTGRES_DB=analyst_hall

ADMIN_EMAIL=admin@malo.academy
ADMIN_PASSWORD=replace-before-deploy
PRO_EMAIL=pro@malo.academy
PRO_PASSWORD=replace-before-deploy

# 1 behind HTTPS. 0 for http://localhost
COOKIE_SECURE=0
PORT=8080
HOST=0.0.0.0
