<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0"
                  xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0"
                  id="Definitions_ATM"
                  targetNamespace="https://malo.academy/bpmn/atm"
                  exporter="Malo Academy">
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="Participant_1" name="Процесс" processRef="Process_ATM" />
  </bpmn:collaboration>
  <bpmn:process id="Process_ATM" name="Сессия банкомата" isExecutable="false">
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="Lane_Client" name="Клиент">
        <bpmn:flowNodeRef>Start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>InsertCard</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_ATM" name="Банкомат">
        <bpmn:flowNodeRef>CheckCard</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GwCard</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CardBad</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>RequestPin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>VerifyPin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GwPin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GwTries</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Capture</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndCapture</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>OpenSess</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SelectOp</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GwOp</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ViewBal</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ShowBal</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EnterAmt</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GwFunds</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>NoFunds</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Complete</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ReturnCard</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndOk</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Proc" name="Процессинг">
        <bpmn:flowNodeRef>CheckFunds</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Out" name="Система вывода">
        <bpmn:flowNodeRef>Cash</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Receipt</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start" name="Начало">
      <bpmn:outgoing>f1</bpmn:outgoing></bpmn:startEvent>
    <bpmn:userTask id="InsertCard" name="Вставить карту">
      <bpmn:incoming>f1</bpmn:incoming>
      <bpmn:outgoing>f2</bpmn:outgoing></bpmn:userTask>
    <bpmn:serviceTask id="CheckCard" name="Проверить карту">
      <bpmn:incoming>f2</bpmn:incoming>
      <bpmn:outgoing>f3</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:exclusiveGateway id="GwCard" name="Карта поддерживается?" gatewayDirection="Diverging">
      <bpmn:incoming>f3</bpmn:incoming>
      <bpmn:outgoing>f4</bpmn:outgoing>
      <bpmn:outgoing>f5</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:task id="CardBad" name="Карта не поддерживается">
      <bpmn:incoming>f4</bpmn:incoming>
      <bpmn:outgoing>f25</bpmn:outgoing></bpmn:task>
    <bpmn:serviceTask id="RequestPin" name="Запросить ПИН-код">
      <bpmn:incoming>f5</bpmn:incoming>
      <bpmn:incoming>f10</bpmn:incoming>
      <bpmn:outgoing>f6</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:serviceTask id="VerifyPin" name="Проверить ПИН-код">
      <bpmn:incoming>f6</bpmn:incoming>
      <bpmn:outgoing>f7</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:exclusiveGateway id="GwPin" name="ПИН верный?" gatewayDirection="Diverging">
      <bpmn:incoming>f7</bpmn:incoming>
      <bpmn:outgoing>f8</bpmn:outgoing>
      <bpmn:outgoing>f12</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="GwTries" name="Попыток больше 3-х раз?" gatewayDirection="Diverging">
      <bpmn:incoming>f8</bpmn:incoming>
      <bpmn:outgoing>f9</bpmn:outgoing>
      <bpmn:outgoing>f10</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Capture" name="Изъять карту">
      <bpmn:incoming>f9</bpmn:incoming>
      <bpmn:outgoing>f11</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:endEvent id="EndCapture" name="Сессия завершена">
      <bpmn:incoming>f11</bpmn:incoming>
      <bpmn:terminateEventDefinition id="TermDef_1" />
    </bpmn:endEvent>
    <bpmn:serviceTask id="OpenSess" name="Открыть сессию">
      <bpmn:incoming>f12</bpmn:incoming>
      <bpmn:outgoing>f13</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:userTask id="SelectOp" name="Выбрать операцию">
      <bpmn:incoming>f13</bpmn:incoming>
      <bpmn:outgoing>f14</bpmn:outgoing></bpmn:userTask>
    <bpmn:exclusiveGateway id="GwOp" name="Какая операция?" gatewayDirection="Diverging">
      <bpmn:incoming>f14</bpmn:incoming>
      <bpmn:outgoing>f15</bpmn:outgoing>
      <bpmn:outgoing>f18</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:serviceTask id="ViewBal" name="Просмотр баланса">
      <bpmn:incoming>f15</bpmn:incoming>
      <bpmn:outgoing>f16</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:userTask id="ShowBal" name="Показать баланс на экране">
      <bpmn:incoming>f16</bpmn:incoming>
      <bpmn:outgoing>f17</bpmn:outgoing></bpmn:userTask>
    <bpmn:userTask id="EnterAmt" name="Ввести сумму">
      <bpmn:incoming>f18</bpmn:incoming>
      <bpmn:outgoing>f19</bpmn:outgoing></bpmn:userTask>
    <bpmn:serviceTask id="CheckFunds" name="Проверить доступность средств">
      <bpmn:incoming>f19</bpmn:incoming>
      <bpmn:outgoing>f20</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:exclusiveGateway id="GwFunds" name="Средства достаточно?" gatewayDirection="Diverging">
      <bpmn:incoming>f20</bpmn:incoming>
      <bpmn:outgoing>f21</bpmn:outgoing>
      <bpmn:outgoing>f22</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:task id="NoFunds" name="Недостаточно средств">
      <bpmn:incoming>f21</bpmn:incoming>
      <bpmn:outgoing>f26</bpmn:outgoing></bpmn:task>
    <bpmn:serviceTask id="Cash" name="Выдать наличные">
      <bpmn:incoming>f22</bpmn:incoming>
      <bpmn:outgoing>f23</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:serviceTask id="Receipt" name="Напечатать чек">
      <bpmn:incoming>f23</bpmn:incoming>
      <bpmn:outgoing>f24</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:serviceTask id="Complete" name="Завершить операцию">
      <bpmn:incoming>f17</bpmn:incoming>
      <bpmn:incoming>f24</bpmn:incoming>
      <bpmn:outgoing>f27</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:serviceTask id="ReturnCard" name="Вернуть карту">
      <bpmn:incoming>f25</bpmn:incoming>
      <bpmn:incoming>f26</bpmn:incoming>
      <bpmn:incoming>f27</bpmn:incoming>
      <bpmn:outgoing>f28</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:endEvent id="EndOk" name="Завершение сессии">
      <bpmn:incoming>f28</bpmn:incoming></bpmn:endEvent>
    <bpmn:sequenceFlow id="f1" sourceRef="Start" targetRef="InsertCard" />
    <bpmn:sequenceFlow id="f2" sourceRef="InsertCard" targetRef="CheckCard" />
    <bpmn:sequenceFlow id="f3" sourceRef="CheckCard" targetRef="GwCard" />
    <bpmn:sequenceFlow id="f4" name="Нет" sourceRef="GwCard" targetRef="CardBad" />
    <bpmn:sequenceFlow id="f5" name="Да (Чиповая / Магнит)" sourceRef="GwCard" targetRef="RequestPin" />
    <bpmn:sequenceFlow id="f6" sourceRef="RequestPin" targetRef="VerifyPin" />
    <bpmn:sequenceFlow id="f7" sourceRef="VerifyPin" targetRef="GwPin" />
    <bpmn:sequenceFlow id="f8" name="Нет" sourceRef="GwPin" targetRef="GwTries" />
    <bpmn:sequenceFlow id="f9" name="Да" sourceRef="GwTries" targetRef="Capture" />
    <bpmn:sequenceFlow id="f10" name="Нет" sourceRef="GwTries" targetRef="RequestPin" />
    <bpmn:sequenceFlow id="f11" sourceRef="Capture" targetRef="EndCapture" />
    <bpmn:sequenceFlow id="f12" name="Да" sourceRef="GwPin" targetRef="OpenSess" />
    <bpmn:sequenceFlow id="f13" sourceRef="OpenSess" targetRef="SelectOp" />
    <bpmn:sequenceFlow id="f14" sourceRef="SelectOp" targetRef="GwOp" />
    <bpmn:sequenceFlow id="f15" name="Баланс" sourceRef="GwOp" targetRef="ViewBal" />
    <bpmn:sequenceFlow id="f16" sourceRef="ViewBal" targetRef="ShowBal" />
    <bpmn:sequenceFlow id="f17" sourceRef="ShowBal" targetRef="Complete" />
    <bpmn:sequenceFlow id="f18" name="Снятие" sourceRef="GwOp" targetRef="EnterAmt" />
    <bpmn:sequenceFlow id="f19" sourceRef="EnterAmt" targetRef="CheckFunds" />
    <bpmn:sequenceFlow id="f20" sourceRef="CheckFunds" targetRef="GwFunds" />
    <bpmn:sequenceFlow id="f21" name="Нет" sourceRef="GwFunds" targetRef="NoFunds" />
    <bpmn:sequenceFlow id="f22" name="Да" sourceRef="GwFunds" targetRef="Cash" />
    <bpmn:sequenceFlow id="f23" sourceRef="Cash" targetRef="Receipt" />
    <bpmn:sequenceFlow id="f24" sourceRef="Receipt" targetRef="Complete" />
    <bpmn:sequenceFlow id="f25" sourceRef="CardBad" targetRef="ReturnCard" />
    <bpmn:sequenceFlow id="f26" sourceRef="NoFunds" targetRef="ReturnCard" />
    <bpmn:sequenceFlow id="f27" sourceRef="Complete" targetRef="ReturnCard" />
    <bpmn:sequenceFlow id="f28" sourceRef="ReturnCard" targetRef="EndOk" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Collaboration_1">
