<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_ATM" name="Сессия банкомата" targetNamespace="http://malo.academy/bpmn/atm" exporter="Malo Academy" exporterVersion="1.0">
  <bpmn:collaboration id="Collaboration_ATM" name="Сессия работы с банкоматом">
    <bpmn:participant id="Participant_Process" name="Процесс" processRef="Process_ATM" />
  </bpmn:collaboration>
  <bpmn:process id="Process_ATM" name="Сессия работы с банкоматом" isExecutable="false" processType="None">
    <bpmn:laneSet id="LaneSet_ATM">
      <bpmn:lane id="Lane_Client" name="Клиент">
        <bpmn:flowNodeRef>StartEvent_Begin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>UserTask_InsertCard</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>UserTask_SelectOp</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>UserTask_EnterAmount</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>UserTask_ShowBalance</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_Session</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_ATM" name="Банкомат">
        <bpmn:flowNodeRef>ServiceTask_CheckCard</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_CardOk</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ServiceTask_RequestPin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ServiceTask_CheckPin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_PinOk</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ServiceTask_OpenSession</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_WhichOp</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ServiceTask_ViewBalance</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ServiceTask_CheckFunds</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_FundsOk</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ServiceTask_CompleteOp</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ReturnCard</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CardUnsupported</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Attempts</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CaptureCard</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_Terminated</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Insufficient</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Processing" name="Процессинг">
        <bpmn:flowNodeRef>ServiceTask_Authorize</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Output" name="Система вывода">
        <bpmn:flowNodeRef>ServiceTask_Dispense</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ServiceTask_Print</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="StartEvent_Begin" name="Начало">
      <bpmn:outgoing>Flow_Start_Insert</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="UserTask_InsertCard" name="Вставить карту">
      <bpmn:incoming>Flow_Start_Insert</bpmn:incoming>
      <bpmn:outgoing>Flow_Insert_Check</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="UserTask_SelectOp" name="Выбрать операцию">
      <bpmn:incoming>Flow_Open_Select</bpmn:incoming>
      <bpmn:outgoing>Flow_Select_Which</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="UserTask_EnterAmount" name="Ввести сумму">
      <bpmn:incoming>Flow_OpWithdraw</bpmn:incoming>
      <bpmn:outgoing>Flow_Amount_Funds</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="UserTask_ShowBalance" name="Показать баланс на экране">
      <bpmn:incoming>Flow_View_Show</bpmn:incoming>
      <bpmn:outgoing>Flow_Show_Complete</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="EndEvent_Session" name="Завершение сессии">
      <bpmn:incoming>Flow_Return_End</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="ServiceTask_CheckCard" name="Проверить карту">
      <bpmn:incoming>Flow_Insert_Check</bpmn:incoming>
      <bpmn:outgoing>Flow_Check_GwCard</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gateway_CardOk" name="Карта поддерживается?" default="Flow_CardYes" gatewayDirection="Diverging">
      <bpmn:incoming>Flow_Check_GwCard</bpmn:incoming>
      <bpmn:outgoing>Flow_CardNo</bpmn:outgoing>
      <bpmn:outgoing>Flow_CardYes</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="ServiceTask_RequestPin" name="Запросить ПИН-код">
      <bpmn:incoming>Flow_CardYes</bpmn:incoming>
      <bpmn:incoming>Flow_RetryPin</bpmn:incoming>
      <bpmn:outgoing>Flow_Req_CheckPin</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="ServiceTask_CheckPin" name="Проверить ПИН-код">
      <bpmn:incoming>Flow_Req_CheckPin</bpmn:incoming>
      <bpmn:outgoing>Flow_CheckPin_Gw</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gateway_PinOk" name="ПИН верный?" default="Flow_PinYes" gatewayDirection="Diverging">
      <bpmn:incoming>Flow_CheckPin_Gw</bpmn:incoming>
      <bpmn:outgoing>Flow_PinNo</bpmn:outgoing>
      <bpmn:outgoing>Flow_PinYes</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="ServiceTask_OpenSession" name="Открыть сессию">
      <bpmn:incoming>Flow_PinYes</bpmn:incoming>
      <bpmn:outgoing>Flow_Open_Select</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gateway_WhichOp" name="Какая операция?" default="Flow_OpWithdraw" gatewayDirection="Diverging">
      <bpmn:incoming>Flow_Select_Which</bpmn:incoming>
      <bpmn:outgoing>Flow_OpBalance</bpmn:outgoing>
      <bpmn:outgoing>Flow_OpWithdraw</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="ServiceTask_ViewBalance" name="Просмотр баланса">
      <bpmn:incoming>Flow_OpBalance</bpmn:incoming>
      <bpmn:outgoing>Flow_View_Show</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="ServiceTask_CheckFunds" name="Проверить доступность средств">
      <bpmn:incoming>Flow_Amount_Funds</bpmn:incoming>
      <bpmn:outgoing>Flow_Funds_Gw</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gateway_FundsOk" name="Средства достаточно?" default="Flow_FundsYes" gatewayDirection="Diverging">
      <bpmn:incoming>Flow_Funds_Gw</bpmn:incoming>
      <bpmn:outgoing>Flow_FundsNo</bpmn:outgoing>
      <bpmn:outgoing>Flow_FundsYes</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="ServiceTask_CompleteOp" name="Завершить операцию">
      <bpmn:incoming>Flow_Show_Complete</bpmn:incoming>
      <bpmn:incoming>Flow_Print_Complete</bpmn:incoming>
      <bpmn:outgoing>Flow_Complete_Return</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_ReturnCard" name="Вернуть карту">
      <bpmn:incoming>Flow_Unsupported_Return</bpmn:incoming>
      <bpmn:incoming>Flow_Insufficient_Return</bpmn:incoming>
      <bpmn:incoming>Flow_Complete_Return</bpmn:incoming>
      <bpmn:outgoing>Flow_Return_End</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:task id="Task_CardUnsupported" name="Карта не поддерживается">
      <bpmn:incoming>Flow_CardNo</bpmn:incoming>
      <bpmn:outgoing>Flow_Unsupported_Return</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_Attempts" name="Попыток больше 3-х раз?" default="Flow_RetryPin" gatewayDirection="Diverging">
      <bpmn:incoming>Flow_PinNo</bpmn:incoming>
      <bpmn:outgoing>Flow_AttemptsYes</bpmn:outgoing>
      <bpmn:outgoing>Flow_RetryPin</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Task_CaptureCard" name="Изъять карту">
      <bpmn:incoming>Flow_AttemptsYes</bpmn:incoming>
      <bpmn:outgoing>Flow_Capture_End</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="EndEvent_Terminated" name="Сессия завершена">
      <bpmn:incoming>Flow_Capture_End</bpmn:incoming>
      <bpmn:terminateEventDefinition id="TerminateEventDefinition_Capture" />
    </bpmn:endEvent>
    <bpmn:task id="Task_Insufficient" name="Недостаточно средств">
      <bpmn:incoming>Flow_FundsNo</bpmn:incoming>
      <bpmn:outgoing>Flow_Insufficient_Return</bpmn:outgoing>
    </bpmn:task>
    <bpmn:serviceTask id="ServiceTask_Authorize" name="Авторизовать снятие">
      <bpmn:incoming>Flow_FundsYes</bpmn:incoming>
      <bpmn:outgoing>Flow_Auth_Dispense</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="ServiceTask_Dispense" name="Выдать наличные">
      <bpmn:incoming>Flow_Auth_Dispense</bpmn:incoming>
      <bpmn:outgoing>Flow_Dispense_Print</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="ServiceTask_Print" name="Напечатать чек">
      <bpmn:incoming>Flow_Dispense_Print</bpmn:incoming>
      <bpmn:outgoing>Flow_Print_Complete</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_Start_Insert" sourceRef="StartEvent_Begin" targetRef="UserTask_InsertCard" />
    <bpmn:sequenceFlow id="Flow_Insert_Check" sourceRef="UserTask_InsertCard" targetRef="ServiceTask_CheckCard" />
    <bpmn:sequenceFlow id="Flow_Check_GwCard" sourceRef="ServiceTask_CheckCard" targetRef="Gateway_CardOk" />
    <bpmn:sequenceFlow id="Flow_CardNo" sourceRef="Gateway_CardOk" targetRef="Task_CardUnsupported" name="Нет" />
    <bpmn:sequenceFlow id="Flow_CardYes" sourceRef="Gateway_CardOk" targetRef="ServiceTask_RequestPin" name="Да (чиповая / магнитная)" />
    <bpmn:sequenceFlow id="Flow_Req_CheckPin" sourceRef="ServiceTask_RequestPin" targetRef="ServiceTask_CheckPin" />
    <bpmn:sequenceFlow id="Flow_CheckPin_Gw" sourceRef="ServiceTask_CheckPin" targetRef="Gateway_PinOk" />
    <bpmn:sequenceFlow id="Flow_PinNo" sourceRef="Gateway_PinOk" targetRef="Gateway_Attempts" name="Нет" />
    <bpmn:sequenceFlow id="Flow_AttemptsYes" sourceRef="Gateway_Attempts" targetRef="Task_CaptureCard" name="Да" />
    <bpmn:sequenceFlow id="Flow_Capture_End" sourceRef="Task_CaptureCard" targetRef="EndEvent_Terminated" />
    <bpmn:sequenceFlow id="Flow_RetryPin" sourceRef="Gateway_Attempts" targetRef="ServiceTask_RequestPin" name="Нет" />
    <bpmn:sequenceFlow id="Flow_PinYes" sourceRef="Gateway_PinOk" targetRef="ServiceTask_OpenSession" name="Да" />
    <bpmn:sequenceFlow id="Flow_Open_Select" sourceRef="ServiceTask_OpenSession" targetRef="UserTask_SelectOp" />
    <bpmn:sequenceFlow id="Flow_Select_Which" sourceRef="UserTask_SelectOp" targetRef="Gateway_WhichOp" />
    <bpmn:sequenceFlow id="Flow_OpBalance" sourceRef="Gateway_WhichOp" targetRef="ServiceTask_ViewBalance" name="Баланс" />
    <bpmn:sequenceFlow id="Flow_View_Show" sourceRef="ServiceTask_ViewBalance" targetRef="UserTask_ShowBalance" />
    <bpmn:sequenceFlow id="Flow_Show_Complete" sourceRef="UserTask_ShowBalance" targetRef="ServiceTask_CompleteOp" />
    <bpmn:sequenceFlow id="Flow_OpWithdraw" sourceRef="Gateway_WhichOp" targetRef="UserTask_EnterAmount" name="Снятие" />
    <bpmn:sequenceFlow id="Flow_Amount_Funds" sourceRef="UserTask_EnterAmount" targetRef="ServiceTask_CheckFunds" />
    <bpmn:sequenceFlow id="Flow_Funds_Gw" sourceRef="ServiceTask_CheckFunds" targetRef="Gateway_FundsOk" />
    <bpmn:sequenceFlow id="Flow_FundsNo" sourceRef="Gateway_FundsOk" targetRef="Task_Insufficient" name="Нет" />
    <bpmn:sequenceFlow id="Flow_FundsYes" sourceRef="Gateway_FundsOk" targetRef="ServiceTask_Authorize" name="Да" />
    <bpmn:sequenceFlow id="Flow_Auth_Dispense" sourceRef="ServiceTask_Authorize" targetRef="ServiceTask_Dispense" />
    <bpmn:sequenceFlow id="Flow_Dispense_Print" sourceRef="ServiceTask_Dispense" targetRef="ServiceTask_Print" />
    <bpmn:sequenceFlow id="Flow_Print_Complete" sourceRef="ServiceTask_Print" targetRef="ServiceTask_CompleteOp" />
    <bpmn:sequenceFlow id="Flow_Unsupported_Return" sourceRef="Task_CardUnsupported" targetRef="Task_ReturnCard" />
    <bpmn:sequenceFlow id="Flow_Insufficient_Return" sourceRef="Task_Insufficient" targetRef="Task_ReturnCard" />
    <bpmn:sequenceFlow id="Flow_Complete_Return" sourceRef="ServiceTask_CompleteOp" targetRef="Task_ReturnCard" />
    <bpmn:sequenceFlow id="Flow_Return_End" sourceRef="Task_ReturnCard" targetRef="EndEvent_Session" />
    <bpmn:textAnnotation id="Annotation_XorNotAnd" textFormat="text/plain">
      <bpmn:text>XOR, не AND: клиент выбирает одну операцию за раз (в исходной схеме здесь ошибочно стоял параллельный шлюз).</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association_XorNote" associationDirection="None" sourceRef="Gateway_WhichOp" targetRef="Annotation_XorNotAnd" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_ATM" name="Сессия банкомата">
    <bpmndi:BPMNPlane id="BPMNPlane_ATM" bpmnElement="Collaboration_ATM">
      <bpmndi:BPMNShape id="Participant_Process_di" bpmnElement="Participant_Process" isHorizontal="true">
        <dc:Bounds x="150" y="80" width="2680" height="920" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Client_di" bpmnElement="Lane_Client" isHorizontal="true">
        <dc:Bounds x="180" y="80" width="2650" height="190" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_ATM_di" bpmnElement="Lane_ATM" isHorizontal="true">
        <dc:Bounds x="180" y="270" width="2650" height="360" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Processing_di" bpmnElement="Lane_Processing" isHorizontal="true">
        <dc:Bounds x="180" y="630" width="2650" height="170" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Output_di" bpmnElement="Lane_Output" isHorizontal="true">
        <dc:Bounds x="180" y="800" width="2650" height="200" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="StartEvent_Begin_di" bpmnElement="StartEvent_Begin" bioc:stroke="#2e7d32" bioc:fill="#c8e6c9" color:background-color="#c8e6c9" color:border-color="#2e7d32">
        <dc:Bounds x="220" y="157" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="202" y="197" width="70" height="20" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="UserTask_InsertCard_di" bpmnElement="UserTask_InsertCard" bioc:stroke="#ef6c00" bioc:fill="#ffe0b2" color:background-color="#ffe0b2" color:border-color="#ef6c00">
        <dc:Bounds x="300" y="135" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="UserTask_SelectOp_di" bpmnElement="UserTask_SelectOp" bioc:stroke="#ef6c00" bioc:fill="#ffe0b2" color:background-color="#ffe0b2" color:border-color="#ef6c00">
        <dc:Bounds x="1280" y="135" width="140" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="UserTask_EnterAmount_di" bpmnElement="UserTask_EnterAmount" bioc:stroke="#ef6c00" bioc:fill="#ffe0b2" color:background-color="#ffe0b2" color:border-color="#ef6c00">
        <dc:Bounds x="1720" y="135" width="130" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="UserTask_ShowBalance_di" bpmnElement="UserTask_ShowBalance" bioc:stroke="#ef6c00" bioc:fill="#ffe0b2" color:background-color="#ffe0b2" color:border-color="#ef6c00">
        <dc:Bounds x="1920" y="135" width="180" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent_Session_di" bpmnElement="EndEvent_Session" bioc:stroke="#2e7d32" bioc:fill="#c8e6c9" color:background-color="#c8e6c9" color:border-color="#2e7d32">
        <dc:Bounds x="2667" y="157" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="2620" y="197" width="130" height="34" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ServiceTask_CheckCard_di" bpmnElement="ServiceTask_CheckCard" bioc:stroke="#8e24aa" bioc:fill="#e1bee7" color:background-color="#e1bee7" color:border-color="#8e24aa">
        <dc:Bounds x="470" y="310" width="130" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_CardOk_di" bpmnElement="Gateway_CardOk" bioc:stroke="#2e7d32" bioc:fill="#c8e6c9" color:background-color="#c8e6c9" color:border-color="#2e7d32">
        <dc:Bounds x="650" y="325" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="610" y="290" width="130" height="30" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ServiceTask_RequestPin_di" bpmnElement="ServiceTask_RequestPin" bioc:stroke="#8e24aa" bioc:fill="#e1bee7" color:background-color="#e1bee7" color:border-color="#8e24aa">
        <dc:Bounds x="760" y="310" width="140" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ServiceTask_CheckPin_di" bpmnElement="ServiceTask_CheckPin" bioc:stroke="#8e24aa" bioc:fill="#e1bee7" color:background-color="#e1bee7" color:border-color="#8e24aa">
        <dc:Bounds x="950" y="310" width="140" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_PinOk_di" bpmnElement="Gateway_PinOk" bioc:stroke="#2e7d32" bioc:fill="#c8e6c9" color:background-color="#c8e6c9" color:border-color="#2e7d32">
        <dc:Bounds x="1140" y="325" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1118" y="290" width="90" height="22" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ServiceTask_OpenSession_di" bpmnElement="ServiceTask_OpenSession" bioc:stroke="#8e24aa" bioc:fill="#e1bee7" color:background-color="#e1bee7" color:border-color="#8e24aa">
        <dc:Bounds x="1280" y="310" width="130" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_WhichOp_di" bpmnElement="Gateway_WhichOp" bioc:stroke="#2e7d32" bioc:fill="#c8e6c9" color:background-color="#c8e6c9" color:border-color="#2e7d32">
        <dc:Bounds x="1600" y="325" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1568" y="290" width="120" height="22" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ServiceTask_ViewBalance_di" bpmnElement="ServiceTask_ViewBalance" bioc:stroke="#8e24aa" bioc:fill="#e1bee7" color:background-color="#e1bee7" color:border-color="#8e24aa">
        <dc:Bounds x="1720" y="310" width="140" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ServiceTask_CheckFunds_di" bpmnElement="ServiceTask_CheckFunds" bioc:stroke="#8e24aa" bioc:fill="#e1bee7" color:background-color="#e1bee7" color:border-color="#8e24aa">
        <dc:Bounds x="1920" y="310" width="180" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_FundsOk_di" bpmnElement="Gateway_FundsOk" bioc:stroke="#2e7d32" bioc:fill="#c8e6c9" color:background-color="#c8e6c9" color:border-color="#2e7d32">
        <dc:Bounds x="2160" y="325" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="2125" y="290" width="130" height="30" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ServiceTask_CompleteOp_di" bpmnElement="ServiceTask_CompleteOp" bioc:stroke="#8e24aa" bioc:fill="#e1bee7" color:background-color="#e1bee7" color:border-color="#8e24aa">
        <dc:Bounds x="2430" y="310" width="140" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_ReturnCard_di" bpmnElement="Task_ReturnCard" bioc:stroke="#8e24aa" bioc:fill="#e1bee7" color:background-color="#e1bee7" color:border-color="#8e24aa">
        <dc:Bounds x="2620" y="310" width="130" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_CardUnsupported_di" bpmnElement="Task_CardUnsupported" bioc:stroke="#c62828" bioc:fill="#ffcdd2" color:background-color="#ffcdd2" color:border-color="#c62828">
        <dc:Bounds x="760" y="510" width="170" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_Attempts_di" bpmnElement="Gateway_Attempts" bioc:stroke="#2e7d32" bioc:fill="#c8e6c9" color:background-color="#c8e6c9" color:border-color="#2e7d32">
        <dc:Bounds x="1140" y="525" width="50" height="50" />
